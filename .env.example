# Token do seu Bot do Discord (obtido no Discord Developer Portal)
DISCORD_TOKEN=seu_token_do_bot_aqui

# ID do cargo de Staff que terá acesso aos tickets abertos (opcional)
STAFF_ROLE_ID=id_do_cargo_de_staff_aqui

# Configurações do Pix para o comando /painelpx
PIX_KEY=sua_chave_pix_aqui
PIX_NAME=Nome do Beneficiario
PIX_CITY=Cidade
